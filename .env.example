# ACP (Virtuals SDK)
# Get these from https://app.virtuals.io/acp/join after registering your agent
WHITELISTED_WALLET_PRIVATE_KEY=  # 0x-prefixed, dev wallet whitelisted during ACP registration
SELLER_AGENT_WALLET_ADDRESS=     # Smart wallet address created during ACP registration
SELLER_ENTITY_ID=                # Session entity ID from ACP registration

# Limitless
PRIVATE_KEY=                     # 0x-prefixed, Limitless trading wallet (Base chain, needs USDC + small ETH for gas)
LIMITLESS_API_URL=https://api.limitless.exchange

# Limitless authentication — HMAC scoped token (required for orders/portfolio).
# Derive with: npm run derive-token -- <privy-identity-token>
# The token must belong to the Limitless account of the TRADING wallet above,
# not the ACP agent smart wallet. See README "Limitless API authentication".
LIMITLESS_HMAC_TOKEN_ID=
LIMITLESS_HMAC_SECRET=
LIMITLESS_API_KEY=               # Legacy static key (deprecated by Limitless, no longer issued)

# Operational
LOG_LEVEL=info
DRY_RUN=false

# Optional local buyer smoke test (run: npm run smoke:buyer)
REQUESTOR_WHITELISTED_WALLET_PRIVATE_KEY=  # Whitelisted EOA private key for your Requestor agent
REQUESTOR_AGENT_WALLET_ADDRESS=             # Requestor agent smart wallet address
REQUESTOR_ENTITY_ID=                        # Requestor entity ID
TARGET_PROVIDER_AGENT_WALLET_ADDRESS=       # Provider agent smart wallet to call (your seller)
SMOKE_OFFERING_NAME=browse_markets
SMOKE_COMPACT=true
SMOKE_REQUIREMENT_JSON=
SMOKE_QUERY=BTC
SMOKE_LIMIT=5
SMOKE_MARKET_SLUG=
SMOKE_SIDE=YES
SMOKE_AMOUNT=0.1
SMOKE_ORDER_TYPE=FOK
SMOKE_LIMIT_PRICE_CENTS=

# Optional provider-only smoke test (bypasses ACP buyer negotiation)
SELLER_SMOKE_OFFERING=browse_markets
SELLER_SMOKE_COMPACT=true
SELLER_SMOKE_REQUIREMENT_JSON=
SELLER_SMOKE_QUERY=BTC
SELLER_SMOKE_MARKET_SLUG=
SELLER_SMOKE_SIDE=YES
SELLER_SMOKE_AMOUNT=0.1
SELLER_SMOKE_ORDER_TYPE=FOK
